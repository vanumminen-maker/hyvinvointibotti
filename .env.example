# Discord Bot Token
# Löytyy: Discord Developer Portal -> Applications -> Bot -> Token
DISCORD_TOKEN=

# Botin Application ID
# Löytyy: Discord Developer Portal -> Applications -> General Information -> Application ID
CLIENT_ID=

# Discord-palvelimen ID
# Discordissa: Asetukset -> Advanced -> Developer Mode päälle -> oikeaklikkaa palvelimen nimeä -> Copy Server ID
GUILD_ID=

# Kanava-ID: päivittäinen kooste + viikkoilmoitukset (molemmat samalle kanavalle)
DAILY_CHANNEL_ID=1272505732264362075
WEEKLY_CHANNEL_ID=1272505732264362075

# Ylläpitoroolin nimi Discordissa (kirjainkoolla väliä)
ADMIN_ROLE_NAME=Ylläpito

# PostgreSQL-yhteysosoite
# Railway asettaa tämän automaattisesti kun lisäät PostgreSQL add-onin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Node-ympäristö (älä muuta)
NODE_ENV=production
